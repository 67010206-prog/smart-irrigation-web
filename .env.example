# ชี้หน้าเว็บไปยัง API จริง (เช่น gateway หรือ backend ของอุปกรณ์)
# ตัวอย่าง: NEXT_PUBLIC_API_BASE_URL=https://api.example.com
#
# - ถ้าเว้นว่าง/ไม่ตั้งค่า จะใช้ same-origin ของเว็บนี้ (/api/...)
# - ต้องรีสตาร์ท dev server หลังแก้ค่า
# - ค่านี้ถูกฝังตอน build จึงใช้ได้กับค่าที่ไม่เป็นความลับเท่านั้น
NEXT_PUBLIC_API_BASE_URL=

# ปลายทาง Node-RED (HTTP IN) ที่ backend ใช้ forward คำสั่งเปิด-ปิดปั๊ม
# ถ้าไม่ตั้งค่า จะใช้ http://13.212.181.250:1880/api/irrigation/pump
NODERED_PUMP_URL=

# ฐาน URL ของ Node-RED (ใช้สร้าง URL คำสั่ง/สถานะถ้าไม่ได้ตั้งค่าด้านล่าง)
NODERED_BASE_URL=
# ปลายทางอ่านสถานะปั๊ม: {"group1":"ON","group2":"OFF",...}
NODERED_STATUS_URL=

# MQTT broker ที่เว็บใช้ฟังสถานะปั๊มจริง (pump/control/groupX)
# ถ้าไม่ตั้งค่า จะใช้ mqtt://13.212.181.250:1883
MQTT_URL=

# บัญชี MQTT (ถ้า broker ต้องมี auth) — เก็บใน .env.local เท่านั้น อย่า commit
MQTT_USERNAME=
MQTT_PASSWORD=

# ---- ที่เก็บข้อมูลถาวร (ทำให้ค่าไม่หายตอน cold start) ----
# ตั้งค่าใดค่าหนึ่ง: Vercel KV หรือ Upstash Redis (REST)
# ถ้าไม่ตั้ง จะใช้หน่วยความจำของ instance (ค่าหายเมื่อ instance ใหม่)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# หรือ
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# เปลี่ยนชื่อ key ได้ (ไม่ต้องตั้งก็ได้)
AGRIFLOW_STATE_KEY=

# ---- Firebase Realtime Database (ที่เก็บข้อมูลหลัก) ----
# สร้าง Realtime Database ใน Firebase Console แล้วเอา URL มาใส่
# ข้อมูลจะถูกเก็บที่ /agriflow/latest และ /agriflow/history/<timestamp>
FIREBASE_DATABASE_URL=
# database secret (Project settings → Service accounts → Database secrets)
# ใส่เมื่อ Rules ไม่ได้เปิดให้อ่าน/เขียน — ห้าม commit ค่านี้
FIREBASE_DATABASE_SECRET=
# เปลี่ยน root node ได้ (ไม่ต้องตั้งก็ได้)
FIREBASE_DB_ROOT=
