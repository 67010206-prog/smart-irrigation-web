# ชี้หน้าเว็บไปยัง API จริง (เช่น gateway หรือ backend ของอุปกรณ์)
# ตัวอย่าง: NEXT_PUBLIC_API_BASE_URL=https://api.example.com
#
# - ถ้าเว้นว่าง/ไม่ตั้งค่า จะใช้ same-origin ของเว็บนี้ (/api/...)
# - ต้องรีสตาร์ท dev server หลังแก้ค่า
# - ค่านี้ถูกฝังตอน build จึงใช้ได้กับค่าที่ไม่เป็นความลับเท่านั้น
NEXT_PUBLIC_API_BASE_URL=

# ปลายทาง Node-RED (HTTP IN) ที่ backend ใช้ forward คำสั่งเปิด-ปิดปั๊ม
# ถ้าไม่ตั้งค่า จะใช้ http://13.212.181.250:1880/api/irrigation/pump
NODERED_PUMP_URL=

# ฐาน URL ของ Node-RED (ใช้สร้าง URL คำสั่ง/สถานะถ้าไม่ได้ตั้งค่าด้านล่าง)
NODERED_BASE_URL=
# ปลายทางอ่านสถานะปั๊ม: {"group1":"ON","group2":"OFF",...}
NODERED_STATUS_URL=

# MQTT broker ที่เว็บใช้ฟังสถานะปั๊มจริง (pump/control/groupX)
# ถ้าไม่ตั้งค่า จะใช้ mqtt://13.212.181.250:1883
MQTT_URL=

# บัญชี MQTT (ถ้า broker ต้องมี auth) — เก็บใน .env.local เท่านั้น อย่า commit
MQTT_USERNAME=
MQTT_PASSWORD=
